<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17"
    android:padding="12dp">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/controlsPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvTallyBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IDLE"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="#334155"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="@+id/cameraPreview"
        app:layout_constraintStart_toStartOf="@+id/cameraPreview" />

    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#131A26"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etCamName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên thiết bị vệ tinh (VD: Cam 1 - Sân khấu)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6" />

        <EditText
            android:id="@+id/etPairToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Token ghép cặp LAN từ App Tổng (tùy chọn)"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:backgroundTint="#10B981" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAudioOnly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Audio Node (chỉ gửi tiếng)"
                android:textColor="#E2E8F0" />

            <Button
                android:id="@+id/btnToggleStream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BẮT ĐẦU GỬI LAN" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chờ kết nối App Tổng qua LAN..."
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

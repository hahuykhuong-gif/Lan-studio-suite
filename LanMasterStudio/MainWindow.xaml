<Window x:Class="LanMasterStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAN Master Studio — Bộ Trộn Camera Vệ Tinh &amp; Live MXH"
        Height="880" Width="1450"
        Background="#0B0F17" Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#131A26"/>
        <SolidColorBrush x:Key="CardBg" Color="#1B2434"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#283548"/>
        <SolidColorBrush x:Key="AccentLive" Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentPreview" Color="#10B981"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="215"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: AUDIO HOT-PLUG + RTMP MXH + INTERCOM + RECORD -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- AUDIO HOT-PLUG -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="ÂM THANH (AUTO HOT-PLUG):" FontWeight="Bold" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ChkAutoAudio" Content="Tự động ưu tiên" IsChecked="True" Foreground="#E2E8F0" VerticalAlignment="Center" Checked="ChkAutoAudio_Changed" Unchecked="ChkAutoAudio_Changed"/>
                        <Button Content="Quét lại" Click="BtnRescanAudio_Click" Margin="8,0,0,0" Padding="6,2" Background="#1E293B" Foreground="White" BorderBrush="#334155"/>
                    </StackPanel>

                    <ItemsControl x:Name="AudioSourcesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" GroupName="AudioGroup" Foreground="White" VerticalAlignment="Center" Checked="AudioSourceRadio_Checked"/>
                                        <ProgressBar Width="45" Height="8" Maximum="1" Value="{Binding PeakLevel}" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#22C55E" Background="#0F172A"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- RTMP SOCIAL LIVE -->
                <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="PHÁT LIVE LÊN MXH (RTMP / RTMPS):" FontWeight="Bold" FontSize="11" Foreground="#FBBF24" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtRtmpUrl" Grid.Column="0" Text="" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="4" Margin="0,0,4,0" ToolTip="RTMP Server URL (VD: rtmp://a.rtmp.youtube.com/live2)"/>
                            <PasswordBox x:Name="PwdStreamKey" Grid.Column="1" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="4" Margin="0,0,6,0" ToolTip="Stream Key (được mã hóa DPAPI trên máy)"/>
                            <ToggleButton x:Name="BtnToggleRtmp" Grid.Column="2" Content="LIVE MXH" Padding="10,4" FontWeight="Bold" Background="#B45309" Foreground="White" Click="BtnToggleRtmp_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- INTERCOM ALL CALL -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ToggleButton x:Name="BtnTalkAll" Content="THOẠI TẤT CẢ" Padding="12,10" FontWeight="Bold"
                                  Background="#1E3A8A" Foreground="White" Click="BtnTalkAll_Click"/>
                </StackPanel>

                <!-- RECORDING -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRecordToggle" Content="● GHI HÌNH" Padding="12,10" FontWeight="Bold"
                            Background="#991B1B" Foreground="White" Click="BtnRecordToggle_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MIDDLE: PREVIEW | SEND | PROGRAM | TOOLS -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AccentPreview}" BorderThickness="1.5" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{StaticResource AccentPreview}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="MÀN PHỤ (DEMO)" FontWeight="Bold" FontSize="11" Foreground="#052E16"/>
                        </Border>
                        <TextBlock Text="Chỉnh sửa chữ, ảnh, bố cục trước khi gửi sang Live" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#020617" CornerRadius="4" ClipToBounds="True">
                        <Canvas x:Name="PreviewCanvas"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0">
                <Button Content="SEND TO LIVE ▶" Padding="10,14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                        Background="#059669" Foreground="White" Margin="0,0,0,10" Click="BtnSendToLive_Click"/>
                <Button Content="SYNC MÀN PHỤ" Padding="8,8" FontSize="11"
                        Background="#1E293B" Foreground="#E2E8F0" Click="BtnSyncFromLive_Click"/>
            </StackPanel>

            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AccentLive}" BorderThickness="2" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{StaticResource AccentLive}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="LIVE CHÍNH (PGM)" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="TxtActiveLiveSummary" Text="Chế độ: 1 Khung" Foreground="#FCA5A5" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#020617" CornerRadius="4" ClipToBounds="True">
                        <Canvas x:Name="ProgramCanvas"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="3" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CHIA KHUNG HÌNH (MÀN PHỤ)" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Button Content="1 Khung" Margin="0,0,4,4" Padding="6" Click="BtnLayoutSingle_Click"/>
                            <Button Content="Chia 2" Margin="4,0,0,4" Padding="6" Click="BtnLayoutSplit2_Click"/>
                            <Button Content="Chia 4" Margin="0,4,4,0" Padding="6" Click="BtnLayoutGrid4_Click"/>
                            <Button Content="PiP (Lồng)" Margin="4,4,0,0" Padding="6" Click="BtnLayoutPip_Click"/>
                        </UniformGrid>

                        <Separator Background="{StaticResource BorderMuted}" Margin="0,2,0,10"/>

                        <TextBlock Text="THÊM CHỮ LÊN KHUNG" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtOverlayInput" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="6" TextChanged="OverlayControls_Changed"/>
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Vị trí X" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="TxtTextX" Text="30" Background="#0F172A" Foreground="White" Padding="4" TextChanged="OverlayControls_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Vị trí Y" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="TxtTextY" Text="360" Background="#0F172A" Foreground="White" Padding="4" TextChanged="OverlayControls_Changed"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BorderMuted}" Margin="0,2,0,10"/>

                        <TextBlock Text="THÊM ẢNH / LOGO" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                        <Button Content="Chọn file ảnh (PNG/JPG)..." Padding="6" Margin="0,0,0,6" Click="BtnPickImage_Click"/>
                        <TextBlock x:Name="TxtSelectedImagePath" Text="Chưa chọn ảnh" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Ảnh X" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="TxtImgX" Text="20" Background="#0F172A" Foreground="White" Padding="4" TextChanged="OverlayControls_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Ảnh Y" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="TxtImgY" Text="20" Background="#0F172A" Foreground="White" Padding="4" TextChanged="OverlayControls_Changed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BOTTOM: SATELLITE DEVICES -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="CAMERA VỆ TINH TRONG MẠNG LAN (Click khung để chọn đưa lên màn hình)" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SatellitesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="245" Background="{StaticResource CardBg}" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="95"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#020617" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="SatelliteCard_Click" Tag="{Binding}">
                                            <Image Source="{Binding LatestFrame}" Stretch="UniformToFill"/>
                                        </Border>

                                        <DockPanel Grid.Row="1" Margin="0,5,0,2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding TallyStatusText}" FontWeight="Bold" FontSize="11" Foreground="#F87171" HorizontalAlignment="Right"/>
                                        </DockPanel>

                                        <DockPanel Grid.Row="2">
                                            <TextBlock Text="{Binding StatusSummary}" FontSize="10" Foreground="#94A3B8" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                            <ToggleButton Content="Thoại riêng" IsChecked="{Binding IsTalkingPrivate}" Padding="6,2" FontSize="11"
                                                          HorizontalAlignment="Right" Click="BtnTalkPrivate_Click" Tag="{Binding}"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#0F172A" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
            <TextBlock x:Name="TxtStatusLog" Text="Sẵn sàng." FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
